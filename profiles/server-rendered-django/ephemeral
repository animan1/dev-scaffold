#!/bin/sh
set -eu

profile_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "${profile_dir}/../.." && pwd)
action=${1:-}

case "${action}" in
  up | smoke | down)
    shift
    target="${action}-ephemeral"
    [ "${action}" != smoke ] || target=verify-ephemeral
    exec make --no-print-directory --directory="${repository_root}" \
      SCAFFOLD_PROFILE=server-rendered-django HOST_INGRESS=0 "${target}" "$@"
    ;;
  *)
    echo "Usage: profiles/server-rendered-django/ephemeral {up|smoke|down} [make arguments...]" >&2
    exit 2
    ;;
esac
