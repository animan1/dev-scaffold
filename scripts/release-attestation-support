#!/usr/bin/env python3
"""Report whether GitHub artifact attestations are available to a repository."""

from __future__ import annotations

import argparse
import sys

VISIBILITIES = {"internal", "private", "public"}
OWNER_TYPES = {"Organization", "User"}


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--visibility", required=True)
    parser.add_argument("--owner-type", required=True)
    parser.add_argument("--nonpublic-opt-in", default="")
    return parser.parse_args()


def main() -> int:
    arguments = _arguments()
    if arguments.visibility not in VISIBILITIES:
        print(
            f"Unsupported repository visibility: {arguments.visibility}",
            file=sys.stderr,
        )
        return 1
    if arguments.owner_type not in OWNER_TYPES:
        print(
            f"Unsupported repository owner type: {arguments.owner_type}",
            file=sys.stderr,
        )
        return 1

    opt_in = arguments.nonpublic_opt_in.lower()
    if opt_in not in {"", "false", "true"}:
        print("Non-public attestation opt-in must be true or false", file=sys.stderr)
        return 1

    supported = arguments.visibility == "public" or opt_in == "true"
    print(str(supported).lower())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
