DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app
# Optional SSH database tunnel; see deploy/remote-db/README.md.
# Put these in deploy/.env.prod for the persistent production Compose workflow.
# DATABASE_URL=postgresql://app:password@remote-db-tunnel:5432/app
# REMOTE_DB_SSH_HOST=db-host.example.com
# REMOTE_DB_SSH_PORT=22
# REMOTE_DB_SSH_USER=operator
# REMOTE_DB_SSH_IDENTITY_FILE=/absolute/path/to/private/key
# REMOTE_DB_SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
# REMOTE_DB_HOST=127.0.0.1
# REMOTE_DB_PORT=15432
# REMOTE_DB_SSH_SERVER_ALIVE_INTERVAL=15
# REMOTE_DB_SSH_SERVER_ALIVE_COUNT_MAX=3
# REMOTE_DB_LOOPBACK_PORT=15432
# REMOTE_DB_BUILD_CONTEXT is set by deploy/remote-db/settings.mk.example.
REDIS_URL=redis://redis:6379/0
DEPLOYMENT_ENVIRONMENT=development
RELEASE_REVISION=unknown
RELEASE_IMAGE_PREFIX=unconfigured
RELEASE_DEPLOYED_AT=
STAGING_STATUS_CA_FILE=
STAGING_REVIEW_URL=
PRODUCTION_STATUS_CA_FILE=
PRODUCTION_REVIEW_URL=
DEPLOYMENT_REMINDER_HOURS=48
MONITOR_SITE_NAME=Application
MONITOR_NOTIFICATION_BACKEND=email
SITE_ADMIN_EMAIL=operator@example.com
DJANGO_DEFAULT_FROM_EMAIL=app@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BACKUP_STATUS_DIR=
BACKUP_MAX_AGE_SECONDS=172800
